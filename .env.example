# Домен, на который смотрит A-запись сервера (Caddy сам получит HTTPS-сертификат)
EPGURU_DOMAIN=epg.example.com
# Пароль входа на сайт
EPGURU_PASSWORD=поменяй-меня
# Секрет для подписи сессий: openssl rand -hex 32
EPGURU_SECRET=
# Максимальный размер одного файла, МБ
EPGURU_MAX_MB=20
# Только для варианта с Cloudflare Tunnel (docker-compose.tunnel.yml)
CF_TUNNEL_TOKEN=
